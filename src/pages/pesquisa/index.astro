---
import { pageCopy } from '../../../data/pages/pesquisa';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale } from '../../i18n';
const locale: Locale = Astro.props.locale ?? 'pt';
const copy = pageCopy[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {locale}
  routeName="research"
  ><header class="page-hero">
    <div class="container">
      <span class="eyebrow">{copy.title}</span><h1>{copy.heading}</h1><p
        class="hero-lead"
      >
        {copy.lead}
      </p>
    </div>
  </header><div class="container">
    <div class="grid">
      {
        copy.cards.map((card, index) => (
          <article class="card">
            <span class="eyebrow">
              {copy.line} {String(index + 1).padStart(2, '0')}
            </span>
            <h2>{card[0]}</h2>
            <p>{card[1]}</p>
          </article>
        ))
      }
    </div><div class="notice">
      <strong>{copy.noticeTitle}</strong>
      {copy.notice}
    </div>
  </div></BaseLayout
>
