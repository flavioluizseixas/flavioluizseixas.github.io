---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { profileLinks } from '../../lib/site';
import { route, type Locale } from '../../i18n';
import profilePhoto from '../../assets/flavio-seixas-retrato-transparente.png';
const locale: Locale = Astro.props.locale ?? 'pt';
const copy = {
  pt: {
    title: 'Sobre',
    description:
      'Biografia, atuação acadêmica e interesses de Flávio Luiz Seixas.',
    jobTitle: 'Professor de Ciência da Computação',
    lead: 'Professor, pesquisador e coordenador de projetos na interseção entre computação, saúde e processos.',
    portrait: 'Retrato de Flávio Luiz Seixas',
    biography: 'Biografia',
    paragraphs: [
      'Professor de Ciência da Computação do Instituto de Computação da Universidade Federal Fluminense (UFF), em Niterói, desde 2017. É doutor em Computação (2012) e mestre em Engenharia de Telecomunicações (2007) pela UFF, MBA em Administração de Empresas e Negócios pela FGV (2002) e engenheiro industrial eletricista, com ênfase em Eletrônica e Telecomunicações, pela UTFPR (1998).',
      'É Jovem Cientista do Nosso Estado (JCNE) pela FAPERJ (2026).',
      'Atua no Programa de Pós-Graduação em Computação (PGC), nas linhas de Inteligência Artificial e Sistemas de Computação; no Mestrado/Doutorado Profissional em Enfermagem Assistencial (PPEA); e colabora com os programas de Ciências Cardiovasculares e de Ciências Médicas da UFF. Coordena o projeto de extensão Fábrica de Software e Tecnologia para a Saúde.',
      'Antes da UFF, atuou na EMBRATEL-Claro SA. nas áreas de qualidade Lean-Seis Sigma, processos BPMN e indicadores operacionais KPIs (1999–2017) e lecionou Engenharia de Telecomunicações na Universidade Estácio de Sá UNESA (2006–2017).'
    ],
    interests: 'Interesses',
    interestItems: [
      'Inteligência artificial aplicada à saúde',
      'Sistemas de suporte à decisão',
      'Processamento de sinais e imagens médicas',
      'Modelagem de processos de negócio',
      'Desenvolvimento organizacional e empreendedorismo inovador'
    ],
    contact: 'Entrar em contato'
  },
  en: {
    title: 'About',
    description:
      'Biography, academic work, and interests of Flávio Luiz Seixas.',
    jobTitle: 'Professor of Computer Science',
    lead: 'Professor, researcher, and project coordinator working at the intersection of computing, healthcare, and processes.',
    portrait: 'Portrait of Flávio Luiz Seixas',
    biography: 'Biography',
    paragraphs: [
      'Professor of Computer Science at the Institute of Computing of Fluminense Federal University (UFF), in Niterói, since 2017. He holds a PhD in Computing (2012) and an MSc in Telecommunications Engineering (2007) from UFF, an MBA in Business Administration from FGV (2002), and a degree in Industrial Electrical Engineering with an emphasis on Electronics and Telecommunications from UTFPR (1998).',
      'He received the Young Scientist of Our State (JCNE) award from FAPERJ in 2026.',
      'He works in UFF’s Graduate Program in Computing (PGC), within the Artificial Intelligence and Computing Systems research areas; in the Professional Master’s and Doctoral Program in Nursing Care (PPEA); and collaborates with UFF’s Cardiovascular Sciences and Medical Sciences programs. He coordinates the Software and Healthcare Technology Factory outreach project.',
      'Before joining UFF, he worked at EMBRATEL-Claro SA. in Lean Six Sigma quality, BPMN processes, and operational KPIs (1999–2017), and taught Telecommunications Engineering at Universidade Estácio de Sá (UNESA) from 2006 to 2017.'
    ],
    interests: 'Interests',
    interestItems: [
      'Artificial intelligence applied to healthcare',
      'Decision support systems',
      'Medical signal and image processing',
      'Business process modeling',
      'Organizational development and innovative entrepreneurship'
    ],
    contact: 'Get in touch'
  }
}[locale];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Flávio Luiz Seixas',
  jobTitle: copy.jobTitle,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidade Federal Fluminense'
  },
  sameAs: profileLinks.map((l) => l.href)
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {locale}
  routeName="about"
  ><script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(person)}
  /><header class="page-hero">
    <div class="container about-hero-grid">
      <div class="about-hero-copy">
        <span class="eyebrow">{copy.title}</span><h1>Flávio Luiz Seixas</h1><p
          class="hero-lead"
        >
          {copy.lead}
        </p>
      </div>
      <figure class="about-portrait">
        <Image
          src={profilePhoto}
          alt={copy.portrait}
          widths={[280, 360, 480]}
          sizes="(max-width: 850px) 220px, 320px"
          loading="eager"
        />
      </figure>
    </div>
  </header><article class="container narrow prose">
    <h2>{copy.biography}</h2>
    {copy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <h2>{copy.interests}</h2><ul>
      {copy.interestItems.map((interest) => <li>{interest}</li>)}
    </ul><p>
      <a class="button" href={route(locale, 'contact')}>{copy.contact}</a>
    </p>
  </article></BaseLayout
>
