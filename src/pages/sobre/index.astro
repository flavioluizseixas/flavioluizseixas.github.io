---
import { pageCopy } from '../../../data/pages/sobre';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { profileLinks } from '../../lib/site';
import { route, type Locale } from '../../i18n';
import site from '../../../data/site.json';
import { contentImage } from '../../lib/images';
const profilePhoto = contentImage(site.images.portrait);
const locale: Locale = Astro.props.locale ?? 'pt';
const copy = pageCopy[locale];
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: copy.jobTitle,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: site.university
  },
  sameAs: profileLinks.map((l) => l.href)
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {locale}
  routeName="about"
  ><script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(person)}
  /><header class="page-hero">
    <div class="container about-hero-grid">
      <div class="about-hero-copy">
        <span class="eyebrow">{copy.title}</span><h1>{site.name}</h1><p
          class="hero-lead"
        >
          {copy.lead}
        </p>
      </div>
      <figure class="about-portrait">
        <Image
          src={profilePhoto}
          alt={copy.portrait}
          widths={[280, 360, 480]}
          sizes="(max-width: 850px) 220px, 320px"
          loading="eager"
        />
      </figure>
    </div>
  </header><article class="container narrow prose">
    <h2>{copy.biography}</h2>
    {copy.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <h2>{copy.interests}</h2><ul>
      {copy.interestItems.map((interest) => <li>{interest}</li>)}
    </ul><p>
      <a class="button" href={route(locale, 'contact')}>{copy.contact}</a>
    </p>
  </article></BaseLayout
>
