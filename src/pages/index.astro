---
import { pageCopy } from '../../data/pages/home';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import { profileLinks, sortCurrentOfferings } from '../lib/site';
import { route, type Locale } from '../i18n';
const locale: Locale = Astro.props.locale ?? 'pt';
const copy = pageCopy[locale];
const offerings = sortCurrentOfferings(
  (await getCollection('offerings')).filter((o) => o.data.current)
);
const currentTerms = [...new Set(offerings.map((o) => o.data.term))].sort();
const currentTerm = currentTerms.join(locale === 'pt' ? ' e ' : ' and ');
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {locale}
  routeName="home"
>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">{copy.role}</span><h1 class="home-hero-title">
        <span>{copy.heading}</span>
        <span class="home-hero-accent">{copy.accent}</span>
      </h1><p class="hero-lead">{copy.lead}</p><div class="hero-actions">
        <a class="button" href={route(locale, 'teaching')}>{copy.coursesCta}</a
        ><a class="button secondary" href={route(locale, 'research')}
          >{copy.researchCta}</a
        >
      </div>
    </div>
  </section>
  <section class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">{copy.semester} {currentTerm}</span><h2>
          {copy.teaching}
        </h2>
      </div><a href={route(locale, 'archive')}>{copy.previous}</a>
    </div><div class="grid">
      {offerings.map((o) => <CourseCard offering={o} {locale} />)}
    </div>
  </section>
  <section class="profile-strip">
    <div class="container">
      <strong>{copy.profiles}</strong><div class="hero-actions">
        {
          profileLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {locale === 'en' && link.label === 'Currículo Lattes'
                ? 'Lattes CV'
                : link.label}
            </a>
          ))
        }<a href={route(locale, 'contact')}>{copy.email}</a>
      </div>
    </div>
  </section>
  <section class="container split">
    <article>
      <span class="eyebrow">{copy.research}</span><h2>
        {copy.researchHeading}
      </h2><p>{copy.researchText}</p><a href={route(locale, 'research')}
        >{copy.researchLink}</a
      >
    </article><article>
      <span class="eyebrow">{copy.outreach}</span><h2>
        {copy.outreachHeading}
      </h2><p>{copy.outreachText}</p><a href={route(locale, 'outreach')}
        >{copy.outreachLink}</a
      >
    </article>
  </section>
</BaseLayout>
