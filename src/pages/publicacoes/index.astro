---
import BaseLayout from '../../layouts/BaseLayout.astro';
import orcidData from '../../data/publications.json';
import {
  abntReference,
  publicationTypeLabels,
  publicationTypeLabelsEn,
  type Publication
} from '../../lib/publications';
import { localeTag, type Locale } from '../../i18n';

const locale: Locale = Astro.props.locale ?? 'pt';
const copy = {
  pt: {
    title: 'Publicações',
    description:
      'Produção acadêmica de Flávio Luiz Seixas importada do ORCID e apresentada segundo o estilo ABNT.',
    eyebrow: 'Produção acadêmica',
    lead: 'Trabalhos divulgados no ORCID, organizados por ano e apresentados em formato de referência ABNT.',
    orcid: 'Consultar perfil no ORCID',
    publications: 'publicações',
    update: 'atualização',
    filters: 'Filtros das publicações',
    type: 'Tipo',
    allTypes: 'Todos os tipos',
    year: 'Ano',
    allYears: 'Todos os anos',
    result: 'resultado',
    results: 'resultados',
    open: 'Consultar publicação',
    dataTitle: 'Sobre os dados bibliográficos',
    dataText:
      'As referências são geradas com os metadados públicos disponíveis no ORCID e no Crossref. A ausência de volume, número ou páginas no registro de origem é preservada, sem completar informações por inferência.'
  },
  en: {
    title: 'Publications',
    description:
      'Academic publications by Flávio Luiz Seixas imported from ORCID and presented in ABNT reference style.',
    eyebrow: 'Academic output',
    lead: 'Works listed on ORCID, organized by year and presented in ABNT reference format.',
    orcid: 'View ORCID profile',
    publications: 'publications',
    update: 'updated',
    filters: 'Publication filters',
    type: 'Type',
    allTypes: 'All types',
    year: 'Year',
    allYears: 'All years',
    result: 'result',
    results: 'results',
    open: 'View publication',
    dataTitle: 'About the bibliographic data',
    dataText:
      'References are generated from public metadata available through ORCID and Crossref. Missing volume, issue, or page information in the source record is preserved and is not inferred.'
  }
}[locale];
const typeLabels =
  locale === 'pt' ? publicationTypeLabels : publicationTypeLabelsEn;
const publications = orcidData.publications as Publication[];
const years = [...new Set(publications.map((publication) => publication.year))];
const types = [...new Set(publications.map((publication) => publication.type))];
const syncedAt = new Intl.DateTimeFormat(localeTag(locale), {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
  timeZone: 'America/Sao_Paulo'
}).format(new Date(orcidData.syncedAt));
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {locale}
  routeName="publications"
>
  <header class="page-hero publications-hero">
    <div class="container">
      <span class="eyebrow">{copy.eyebrow}</span><h1>{copy.title}</h1><p
        class="hero-lead"
      >
        {copy.lead}
      </p><div class="hero-actions">
        <a
          class="button"
          href={`https://orcid.org/${orcidData.orcid}`}
          target="_blank"
          rel="noopener noreferrer">{copy.orcid}</a
        ><span class="publication-count"
          >{publications.length}
          {copy.publications} · {copy.update}
          {syncedAt}</span
        >
      </div>
    </div>
  </header>
  <div class="container publications-content">
    <div
      class="publication-controls"
      aria-label={copy.filters}
      data-result-singular={copy.result}
      data-result-plural={copy.results}
    >
      <label>
        {copy.type}
        <select id="publication-type">
          <option value="all">{copy.allTypes}</option>
          {
            types.map((type) => (
              <option value={type}>{typeLabels[type] ?? type}</option>
            ))
          }
        </select>
      </label>
      <label>
        {copy.year}
        <select id="publication-year">
          <option value="all">{copy.allYears}</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>
      <p id="publication-result-count" aria-live="polite">
        {publications.length}
        {copy.results}
      </p>
    </div>
    <div class="publication-years">
      {
        years.map((year) => (
          <section class="publication-year" data-year-group={year}>
            <h2>{year}</h2>
            <ol class="publication-list">
              {publications
                .filter((publication) => publication.year === year)
                .map((publication) => (
                  <li
                    class="publication-item"
                    data-year={publication.year}
                    data-type={publication.type}
                  >
                    <span class="tag">
                      {typeLabels[publication.type] ?? publication.type}
                    </span>
                    <p class="abnt-reference">{abntReference(publication)}</p>
                    {publication.doi ? (
                      <a
                        href={publication.url ?? undefined}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        DOI: {publication.doi}
                      </a>
                    ) : (
                      publication.url && (
                        <a
                          href={publication.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {copy.open}
                        </a>
                      )
                    )}
                  </li>
                ))}
            </ol>
          </section>
        ))
      }
    </div>
    <aside class="notice publication-note">
      <strong>{copy.dataTitle}</strong><br />{copy.dataText}
    </aside>
    <script>
      const publicationControls = document.querySelector<HTMLElement>(
        '.publication-controls'
      );
      const resultSingular =
        publicationControls?.dataset.resultSingular ?? 'resultado';
      const resultPlural =
        publicationControls?.dataset.resultPlural ?? 'resultados';
      const typeSelect =
        document.querySelector<HTMLSelectElement>('#publication-type');
      const yearSelect =
        document.querySelector<HTMLSelectElement>('#publication-year');
      const resultCount = document.querySelector('#publication-result-count');
      const filterPublications = () => {
        let visible = 0;
        document
          .querySelectorAll<HTMLElement>('.publication-item')
          .forEach((item) => {
            const matchesType =
              typeSelect?.value === 'all' ||
              item.dataset.type === typeSelect?.value;
            const matchesYear =
              yearSelect?.value === 'all' ||
              item.dataset.year === yearSelect?.value;
            item.hidden = !(matchesType && matchesYear);
            if (!item.hidden) visible += 1;
          });
        document
          .querySelectorAll<HTMLElement>('.publication-year')
          .forEach((group) => {
            group.hidden = !group.querySelector(
              '.publication-item:not([hidden])'
            );
          });
        if (resultCount)
          resultCount.textContent = `${visible} ${
            visible === 1 ? resultSingular : resultPlural
          }`;
      };
      typeSelect?.addEventListener('change', filterPublications);
      yearSelect?.addEventListener('change', filterPublications);
    </script>
  </div>
</BaseLayout>
