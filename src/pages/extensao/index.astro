---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExtensionCatalog from '../../components/ExtensionCatalog.astro';
import '../../styles/extension-projects.css';
import { route, type Locale } from '../../i18n';
const locale: Locale = Astro.props.locale ?? 'pt';
const copy = {
  pt: {
    title: 'Extensão',
    description:
      'Conheça os projetos de Iniciação Científica e Extensão da Fábrica de Software e Tecnologia para a Saúde: oportunidades, dedicação e participação.',
    heading: 'Tecnologia construída em colaboração',
    lead: 'Projetos que aproximam estudantes, universidade, profissionais e necessidades da sociedade.',
    project: 'Fábrica de Software e Tecnologia para a Saúde',
    projectText:
      'Projeto coordenado desde 2017 que articula formação discente e desenvolvimento de soluções computacionais para desafios da saúde.',
    projectText2:
      'O trabalho favorece experiências interdisciplinares, aprendizagem baseada em projetos e transferência de conhecimento.',
    results: 'Projetos de Iniciação Científica e Extensão',
    resultsText: 'Conheça as oportunidades de participação para estudantes.',
    catalogLink: 'Explorar os projetos'
  },
  en: {
    title: 'Outreach',
    description: 'Outreach projects in software and healthcare technology.',
    heading: 'Technology built through collaboration',
    lead: 'Projects connecting students, the university, professionals, and societal needs.',
    project: 'Software and Healthcare Technology Factory',
    projectText:
      'A project coordinated since 2017 that combines student education with the development of computational solutions for healthcare challenges.',
    projectText2:
      'The work fosters interdisciplinary experiences, project-based learning, and knowledge transfer.',
    results: 'Undergraduate research and outreach projects',
    resultsText:
      'Project descriptions and participation opportunities are currently available in Portuguese.',
    catalogLink: 'Explore projects in Portuguese'
  }
}[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {locale}
  routeName="outreach"
  ><header class="page-hero extension-hero">
    <div class="container">
      <span class="eyebrow">{copy.title}</span><h1>{copy.heading}</h1><p
        class="hero-lead"
      >
        {copy.lead}
      </p>
      <div class="extension-intro">
        <h2>{copy.project}</h2><p>{copy.projectText} {copy.projectText2}</p>
      </div>
    </div>
  </header>
  {
    locale === 'pt' ? (
      <ExtensionCatalog />
    ) : (
      <section class="container" aria-labelledby="catalog-heading">
        <>
          <h2 id="catalog-heading">{copy.results}</h2>
          <p>{copy.resultsText}</p>
        </>
        <a
          class="button"
          href={`${route('pt', 'outreach')}#novas-oportunidades`}
          data-locale="pt"
        >
          {copy.catalogLink}
        </a>
      </section>
    )
  }
</BaseLayout>
