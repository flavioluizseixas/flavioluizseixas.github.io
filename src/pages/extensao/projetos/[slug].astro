---
import { detailCopy as copy } from '../../../../data/extension-catalog';
import ExtensionProjectLogo from '../../../components/ExtensionProjectLogo.astro';
import ProjectRegistrationForm from '../../../components/ProjectRegistrationForm.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ExtensionProjectBadges from '../../../components/ExtensionProjectBadges.astro';
import { PROJECT_STATUS_LABELS } from '../../../lib/extension-projects';
import { formatDate } from '../../../lib/site';
import { route } from '../../../i18n';
import '../../../styles/extension-projects.css';

export async function getStaticPaths() {
  return (await getCollection('extensionProjects')).map((project) => ({
    params: { slug: project.data.slug },
    props: { project }
  }));
}
interface Props {
  project: CollectionEntry<'extensionProjects'>;
}
const { project } = Astro.props;
const data = project.data;
const { Content } = await render(project);
---

<BaseLayout title={data.titulo} description={data.resumo_curto}>
  <header class="page-hero project-detail-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label={copy.breadcrumbs}>
        <a href={route('pt', 'outreach')}>{copy.outreach}</a><span
          aria-hidden="true"
        >
          /
        </span>
        <a href={`${route('pt', 'outreach')}#todos-os-projetos`}
          >{copy.projects}</a
        ><span aria-hidden="true"> / </span>
        <span aria-current="page">{data.titulo}</span>
      </nav>
      <ExtensionProjectLogo logo={data.logo} prominent />
      <ExtensionProjectBadges project={data} />
      <h1>{data.titulo}</h1>
      <p class="hero-lead">{data.resumo_curto}</p>
      <dl class="facts project-facts">
        <div>
          <dt>{copy.status}</dt><dd>{PROJECT_STATUS_LABELS[data.status]}</dd>
        </div>
        <div>
          <dt>{copy.modality}</dt><dd>{data.modalidade.join(' / ')}</dd>
        </div>
        <div><dt>{copy.workload}</dt><dd>{data.carga_horaria}</dd></div>
        <div>
          <dt>{copy.semester}</dt><dd>{data.semestre_divulgacao}</dd>
        </div>
      </dl>
      <p class="course-meta">{copy.areas}: {data.area.join(' · ')}</p>
    </div>
  </header>
  <article class="container narrow prose project-detail">
    <Content />
    <section aria-labelledby="team-heading">
      <h2 id="team-heading">{copy.team}</h2>
      <ul class="project-team">
        {
          data.equipe.map((member) => (
            <li>
              <>
                <strong>{member.nome}</strong>
                <span>{member.vinculo}</span>
              </>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="keywords-heading">
      <h2 id="keywords-heading">{copy.keywords}</h2>
      <ul class="project-keywords">
        {data.palavras_chave.map((keyword) => <li>{keyword}</li>)}
      </ul>
    </section>
    {
      data.status === 'inscricoes-abertas' && data.link_inscricao && (
        <section class="notice" aria-labelledby="registration-heading">
          <h2 id="registration-heading">{copy.participate}</h2>
          {data.data_encerramento_inscricoes && (
            <p>
              {copy.deadline}{' '}
              <time datetime={data.data_encerramento_inscricoes}>
                {formatDate(data.data_encerramento_inscricoes)}
              </time>
              .
            </p>
          )}
          <a class="button" href={data.link_inscricao}>
            {copy.registration}
          </a>
        </section>
      )
    }
    {
      data.status === 'inscricoes-abertas' && !data.link_inscricao && (
        <ProjectRegistrationForm
          project={data.slug}
          term={data.semestre_divulgacao}
        />
      )
    }
    <div class="project-back">
      <a href={`${route('pt', 'outreach')}#todos-os-projetos`}>← {copy.back}</a>
    </div>
  </article>
</BaseLayout>
