---
import BaseLayout from '../layouts/BaseLayout.astro';
import { route, type Locale } from '../i18n';
const locale: Locale = Astro.url.pathname
  .replace(import.meta.env.BASE_URL, '/')
  .startsWith('/en/')
  ? 'en'
  : 'pt';
const copy = {
  pt: {
    title: 'Página não encontrada',
    eyebrow: 'Erro 404',
    description: 'A página solicitada não foi encontrada.',
    heading: 'Esta página não está por aqui.',
    lead: 'O endereço pode ter mudado durante a migração do site antigo.',
    courses: 'Ver disciplinas',
    search: 'Buscar no site'
  },
  en: {
    title: 'Page not found',
    eyebrow: 'Error 404',
    description: 'The requested page could not be found.',
    heading: 'This page is not here.',
    lead: 'The address may have changed during the migration from the old site.',
    courses: 'View courses',
    search: 'Search the site'
  }
}[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {locale}
  alternateHref={route(locale === 'pt' ? 'en' : 'pt', 'home')}
  ><div class="container narrow">
    <span class="eyebrow">{copy.eyebrow}</span><h1>{copy.heading}</h1><p
      class="hero-lead"
    >
      {copy.lead}
    </p><div class="hero-actions">
      <a class="button" href={route(locale, 'teaching')}>{copy.courses}</a><a
        class="button secondary"
        href={route(locale, 'search')}>{copy.search}</a
      >
    </div>
  </div></BaseLayout
>
