---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { courseRoute, type Locale } from '../../i18n';
import { translateContent } from '../../i18n/content';
const locale: Locale = Astro.props.locale ?? 'pt';
const copy = {
  pt: {
    title: 'Arquivo',
    description: 'Disciplinas anteriores, organizadas por semestre.',
    eyebrow: 'Memória acadêmica',
    heading: 'Arquivo de disciplinas',
    lead: 'Calendários antigos permanecem em URLs próprias e são identificados como disciplinas encerradas.',
    open: 'Abrir disciplina'
  },
  en: {
    title: 'Archive',
    description: 'Previous courses organized by term.',
    eyebrow: 'Academic record',
    heading: 'Course archive',
    lead: 'Past calendars remain available at permanent URLs and are clearly identified as completed courses.',
    open: 'Open course'
  }
}[locale];
const entries = (await getCollection('offerings'))
  .filter((e) => !e.data.current)
  .sort((a, b) => b.data.term.localeCompare(a.data.term));
const groups = Object.groupBy(entries, (e) => e.data.term);
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {locale}
  routeName="archive"
  ><header class="page-hero">
    <div class="container">
      <span class="eyebrow">{copy.eyebrow}</span><h1>{copy.heading}</h1><p
        class="hero-lead"
      >
        {copy.lead}
      </p>
    </div>
  </header><div class="container narrow">
    {
      Object.entries(groups).map(([term, items]) => (
        <section>
          <h2>{term}</h2>
          {items?.map((item) => (
            <article class="card">
              <span class="eyebrow">{item.data.code}</span>
              <h3>{translateContent(item.data.title, locale)}</h3>
              <p>{translateContent(item.data.summary, locale)}</p>
              <a href={courseRoute(locale, item.data.slug, item.data.term)}>
                {copy.open} {term}
              </a>
            </article>
          ))}
        </section>
      ))
    }
  </div></BaseLayout
>
