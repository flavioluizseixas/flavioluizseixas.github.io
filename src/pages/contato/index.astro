---
import site from '../../../data/site.json';
import { pageCopy } from '../../../data/pages/contato';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Locale } from '../../i18n';
const locale: Locale = Astro.props.locale ?? 'pt';
const copy = pageCopy[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  {locale}
  routeName="contact"
  ><header class="page-hero">
    <div class="container">
      <span class="eyebrow">{copy.title}</span><h1>{copy.heading}</h1><p
        class="hero-lead"
      >
        {copy.lead}
      </p>
    </div>
  </header><div class="container split">
    <article>
      <h2>{copy.email}</h2><p>
        <a
          id="email"
          href="#"
          data-user={site.email.user}
          data-domain={site.email.domain}
        >
          {site.email.user} [{copy.at}] {site.email.domain}
        </a>
      </p><p class="course-meta">
        {copy.emailNote}
      </p>
    </article><article>
      <h2>{copy.address}</h2><address>
        {copy.room}<br />{copy.campus}<br />{copy.street}<br />{copy.city}<br
        />{copy.postal}
      </address>
    </article>
  </div><script>
    const e = document.querySelector<HTMLElement>('#email');
    if (e) {
      const a = [e.dataset.user, e.dataset.domain].join('@');
      e.setAttribute('href', `mailto:${a}`);
      e.textContent = a;
    }
  </script></BaseLayout
>
