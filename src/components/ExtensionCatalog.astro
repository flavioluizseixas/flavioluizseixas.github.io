---
import { catalogCopy as copy } from '../../data/extension-catalog';
import { getCollection } from 'astro:content';
import ExtensionProjectCard from './ExtensionProjectCard.astro';
import {
  groupProjects,
  filterValue,
  resultCount
} from '../lib/extension-projects';
import { route } from '../i18n';

const { opportunities, searchable: projects } = groupProjects(
  await getCollection('extensionProjects')
);
const options = (key: 'modalidade' | 'area') =>
  [...new Set(projects.flatMap(({ data }) => data[key]))].sort((a, b) =>
    a.localeCompare(b, 'pt-BR')
  );
---

<div class="container extension-catalog" id="todos-os-projetos">
  <section
    id="novas-oportunidades"
    aria-labelledby="new-projects-heading"
    hidden={opportunities.length === 0}
  >
    <div class="section-head">
      <div>
        <span class="eyebrow">{copy.eyebrow}</span><h2
          id="new-projects-heading"
        >
          {copy.opportunities}
        </h2><p>
          {copy.introduction}
        </p>
      </div>
    </div>
    <div class="project-grid">
      {
        opportunities.map(({ data }) => (
          <ExtensionProjectCard project={data} featured />
        ))
      }
    </div>
  </section>

  <section
    class="project-explore"
    aria-labelledby="explore-heading"
    data-project-catalog
  >
    <div class="section-head project-results-heading">
      <h2 id="explore-heading">{copy.explore}</h2>
      <p
        data-result-count
        role="status"
        aria-live="polite"
        aria-atomic="true"
        hidden={projects.length === 0}
      >
        {resultCount(projects.length)}
      </p>
    </div>
    <form
      class="project-controls"
      role="search"
      aria-label={copy.searchLabel}
      hidden
    >
      <label class="project-search"
        >{copy.search}
        <input
          type="search"
          name="q"
          placeholder={copy.searchPlaceholder}
          autocomplete="off"
          aria-controls="project-results"
        />
      </label>
      <div class="project-field">
        <label for="project-status">{copy.status}</label>
        <select
          id="project-status"
          name="status"
          aria-controls="project-results"
        >
          <option value="">{copy.allStatuses}</option>
          <option value="em-andamento">{copy.ongoing}</option>
          <option value="concluido">{copy.completed}</option>
        </select>
      </div>
      <div class="project-field">
        <label for="project-modalidade">{copy.modality}</label>
        <select
          id="project-modalidade"
          name="modalidade"
          aria-controls="project-results"
        >
          <option value="">{copy.allOptions}</option>
          {
            options('modalidade').map((value) => (
              <option value={filterValue(value)}>{value}</option>
            ))
          }
        </select>
      </div>
      <div class="project-field">
        <label for="project-area">{copy.area}</label>
        <select id="project-area" name="area" aria-controls="project-results">
          <option value="">{copy.allOptions}</option>
          {
            options('area').map((value) => (
              <option value={filterValue(value)}>{value}</option>
            ))
          }
        </select>
      </div>
      <button type="reset" class="button secondary">{copy.clear}</button>
    </form>
    {
      projects.length > 0 && (
        <noscript>
          <p>{copy.noScript}</p>
        </noscript>
      )
    }
    <div
      id="project-results"
      class="project-grid"
      aria-labelledby="explore-heading"
    >
      {projects.map(({ data }) => <ExtensionProjectCard project={data} />)}
    </div>
    <div class="empty" data-project-empty hidden={projects.length > 0}>
      <p>
        {projects.length ? copy.noResults : copy.empty}
      </p>
      <button
        type="button"
        class="button secondary"
        data-clear-projects
        hidden={projects.length === 0}>{copy.clear}</button
      >
    </div>
  </section>

  <section
    class="notice project-participate"
    aria-labelledby="participate-heading"
  >
    <div>
      <h2 id="participate-heading">{copy.participate}</h2><p>
        {copy.participation}
      </p>
    </div>
    <a class="button" href={route('pt', 'contact')}>{copy.contact}</a>
  </section>
</div>

<script>
  import '../scripts/extension-catalog';
</script>
