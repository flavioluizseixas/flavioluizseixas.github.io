---
import site from '../../data/site.json';
import { pageCopy } from '../../data/i18n/OfferingPage';
import BaseLayout from '../layouts/BaseLayout.astro';
import Agenda from './Agenda.astro';
import { withBase } from '../lib/site';
import { courseRoute, route, type Locale } from '../i18n';
import { localizeOffering } from '../i18n/content';
const { offering, locale = 'pt' } = Astro.props as {
  offering: any;
  locale?: Locale;
};
const copy = pageCopy[locale];
const d = localizeOffering(offering.data, locale);
const alternateLocale = locale === 'pt' ? 'en' : 'pt';
const alternateHref = courseRoute(alternateLocale, d.slug, d.term);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: d.title,
  courseCode: d.code,
  description: d.summary,
  provider: {
    '@type': 'CollegeOrUniversity',
    name: site.university
  }
};
---

<BaseLayout
  title={`${d.title} · ${d.term}`}
  description={d.summary}
  {locale}
  {alternateHref}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <header class="page-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href={route(locale, 'teaching')}>{copy.teaching}</a> / {d.title}
      </div><span class="eyebrow"
        >{d.code} · {
          d.level === 'graduacao' ? copy.undergraduate : copy.graduate
        }</span
      ><h1>{d.title}</h1><p class="hero-lead">{d.summary}</p>{
        !d.current && (
          <div class="archive-banner">
            <>
              <strong>
                {copy.archived} {d.term}
              </strong>
              <br />
            </>
            {copy.archivedText}
          </div>
        )
      }{
        d.notice && (
          <div class="notice">
            <br />
            {d.notice}
          </div>
        )
      }<div class="course-summary">
        <dl class="facts">
          <div><dt>{copy.term}</dt><dd>{d.term}</dd></div><div>
            <dt>{copy.classGroup}</dt><dd>{d.class_group}</dd>
          </div>{
            d.instructors.length > 0 && (
              <div>
                <>
                  <dt>{copy.instructors}</dt>
                  <dd>{d.instructors.join(' · ')}</dd>
                </>
              </div>
            )
          }<div><dt>{copy.schedule}</dt><dd>{d.schedule}</dd></div><div>
            <dt>{copy.room}</dt><dd>{d.room || copy.pending}</dd>
          </div>{
            d.workload && (
              <div>
                <>
                  <dt>{copy.workload}</dt>
                  <dd>{d.workload}</dd>
                </>
              </div>
            )
          }{
            d.credits && (
              <div>
                <>
                  <dt>{copy.credits}</dt>
                  <dd>{d.credits}</dd>
                </>
              </div>
            )
          }{
            d.prerequisites.length > 0 && (
              <div>
                <>
                  <dt>{copy.prerequisites}</dt>
                  <dd>{d.prerequisites.join(` ${copy.or} `)}</dd>
                </>
              </div>
            )
          }<div>
            <dt>{copy.classroom}</dt><dd>
              {
                d.classroom_url || d.classroom_code ? (
                  <>
                    {d.classroom_url && (
                      <a
                        href={d.classroom_url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {copy.classroomLink}
                      </a>
                    )}
                    {d.classroom_url && d.classroom_code ? ' · ' : ''}
                    {d.classroom_code && (
                      <>
                        {copy.classroomCode}: <code>{d.classroom_code}</code>
                      </>
                    )}
                  </>
                ) : (
                  copy.pending
                )
              }
            </dd>
          </div>
        </dl><div>
          <span class="label">{copy.updated}</span><p>{d.updated}</p><a
            href={withBase(
              locale === 'pt'
                ? `feed/${d.slug}-${d.term.replace('.', '-')}.ics`
                : `feed/en/${d.slug}-${d.term.replace('.', '-')}.ics`
            )}>{copy.addCalendar}</a
          >
        </div>
      </div>
    </div>
  </header>
  <nav class="in-page-nav" aria-label={copy.pageNav}>
    <div>
      <a href={locale === 'pt' ? '#visao-geral' : '#overview'}
        >{copy.overview}</a
      ><a href={locale === 'pt' ? '#calendario' : '#calendar'}
        >{copy.calendar}</a
      ><a href={locale === 'pt' ? '#avaliacao' : '#assessment'}
        >{copy.assessment}</a
      ><a href={locale === 'pt' ? '#materiais' : '#materials'}
        >{copy.materials}</a
      ><a href={locale === 'pt' ? '#referencias' : '#references'}
        >{copy.references}</a
      >
    </div>
  </nav>
  <div class="container">
    <section
      class="prose narrow course-section"
      id={locale === 'pt' ? 'visao-geral' : 'overview'}
    >
      <h2>{copy.overview}</h2>
      <p>{d.overview || d.summary}</p>
      {
        d.objective && (
          <>
            <h3>{copy.objective}</h3>
            <p>{d.objective}</p>
          </>
        )
      }
      {
        d.syllabus.length > 0 && (
          <>
            <h3>{copy.syllabus}</h3>
            <ol>
              {d.syllabus.map((topic: string) => (
                <li>{topic}</li>
              ))}
            </ol>
          </>
        )
      }
      {
        d.methodology && (
          <>
            <h3>{copy.methodology}</h3>
            <p>{d.methodology}</p>
          </>
        )
      }
    </section>
    <Agenda events={d.calendar} {locale} />
    <section
      class="prose narrow course-section"
      id={locale === 'pt' ? 'avaliacao' : 'assessment'}
    >
      <h2>{copy.assessment}</h2>
      <p>
        {d.evaluation || copy.assessmentFallback}
      </p>
    </section>
    <section
      class="course-section"
      id={locale === 'pt' ? 'materiais' : 'materials'}
    >
      <h2>{copy.materials}</h2>
      {
        d.materials.length > 0 ? (
          <div class="resources">
            {d.materials.map((m: any) => (
              <a
                class="resource"
                href={m.url}
                target={m.external ? '_blank' : undefined}
                rel={m.external ? 'noopener noreferrer' : undefined}
              >
                <strong>{m.title}</strong>
                <span>
                  {
                    copy.materialTypes[
                      m.type as keyof typeof copy.materialTypes
                    ]
                  }
                  {m.external ? ` · ${copy.external}` : ''}
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="empty">{copy.materialsEmpty}</p>
        )
      }
    </section>
    <section
      class="prose narrow course-section"
      id={locale === 'pt' ? 'referencias' : 'references'}
    >
      <h2>{copy.references}</h2>
      {
        d.references.length > 0 ? (
          <ul>
            {d.references.map((reference: string) => (
              <li>{reference}</li>
            ))}
          </ul>
        ) : (
          <p class="empty">{copy.referencesEmpty}</p>
        )
      }
    </section>
  </div>
</BaseLayout>
