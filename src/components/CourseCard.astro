---
import { formatDate, todayInSaoPaulo } from '../lib/site';
import { courseRoute, localeTag, type Locale } from '../i18n';
import { localizeOffering } from '../i18n/content';
const { offering, locale = 'pt' } = Astro.props as {
  offering: any;
  locale?: Locale;
};
const copy = {
  pt: {
    classGroup: 'Turma',
    instructors: 'Docentes',
    room: 'Sala',
    roomPending: 'Sala a confirmar',
    next: 'Próxima atividade',
    noNext: 'Sem novas atividades previstas',
    calendar: 'Ver calendário',
    filter: 'Disciplina'
  },
  en: {
    classGroup: 'Class',
    instructors: 'Instructors',
    room: 'Room',
    roomPending: 'Room to be confirmed',
    next: 'Next activity',
    noNext: 'No upcoming activities',
    calendar: 'View calendar',
    filter: 'Course'
  }
}[locale];
const data = localizeOffering(offering.data, locale);
const today = todayInSaoPaulo();
const next = data.calendar
  .filter(
    (e: any) =>
      e.date >= today && !['cancelled', 'completed'].includes(e.status)
  )
  .sort((a: any, b: any) => a.date.localeCompare(b.date))[0];
---

<article class="card course-card" data-pagefind-filter={`type:${copy.filter}`}>
  <span class="eyebrow">{data.code} · {data.term}</span>
  <h3>{data.title}</h3><p class="course-meta">
    {copy.classGroup}
    {data.class_group}<br />{
      data.instructors.length > 0 && (
        <>
          {copy.instructors}: {data.instructors.join(' · ')}
          <br />
        </>
      )
    }{data.schedule}<br />{
      data.room ? `${copy.room} ${data.room}` : copy.roomPending
    }
  </p>
  <div class="next">
    <small>{copy.next}</small>{
      next ? (
        <>
          <>
            <strong>{next.title}</strong>
            <time datetime={next.date}>
              {formatDate(next.date, { weekday: 'short' }, localeTag(locale))}
            </time>
          </>
        </>
      ) : (
        <strong>{copy.noNext}</strong>
      )
    }
  </div>
  <div class="card-actions">
    <a
      class="button"
      href={courseRoute(
        locale,
        data.slug,
        data.term,
        locale === 'pt' ? '#calendario' : '#calendar'
      )}>{copy.calendar}</a
    >
  </div>
</article>
