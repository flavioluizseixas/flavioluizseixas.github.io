---
import { catalogCopy as copy } from '../../data/extension-catalog';
import type { ExtensionProject } from '../lib/extension-project-schema';
import { withBase } from '../lib/site';
import { filterValue, projectSearchText } from '../lib/extension-projects';
import ExtensionProjectBadges from './ExtensionProjectBadges.astro';
import ExtensionProjectLogo from './ExtensionProjectLogo.astro';
interface Props {
  project: ExtensionProject;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
---

<article
  class:list={['card', 'project-card', { 'project-featured': featured }]}
  data-project={project.slug}
  data-search={featured ? undefined : projectSearchText(project)}
  data-status={project.status}
  data-area={JSON.stringify(project.area.map(filterValue))}
  data-modalidade={JSON.stringify(project.modalidade.map(filterValue))}
>
  <ExtensionProjectLogo logo={project.logo} />
  <ExtensionProjectBadges {project} />
  <h3>{project.titulo}</h3>
  <p class="project-summary">{project.resumo_curto}</p>
  <p class="project-modality">{project.modalidade.join(' · ')}</p>
  <p class="project-areas">
    {project.area.slice(0, featured ? 1 : 2).join(' · ')}
    {
      !featured && project.area.length > 2 && (
        <span title={project.area.slice(2).join(' · ')}>
          {' '}
          · +{project.area.length - 2} {copy.areas}
        </span>
      )
    }
  </p>
  <p class="project-meta">
    <span
      >{
        project.carga_horaria.replace(copy.weeklyHours, copy.weeklyHoursShort)
      }</span
    ><span aria-label={`${copy.semester}: ${project.semestre_divulgacao}`}
      >{project.semestre_divulgacao}</span
    >
  </p>
  <a
    class="project-link"
    href={withBase(`extensao/projetos/${project.slug}/`)}
    aria-label={`${featured ? copy.discover : copy.details}: ${project.titulo}`}
  >
    {featured ? copy.discover : copy.details}
    <span aria-hidden="true">→</span>
  </a>
</article>
