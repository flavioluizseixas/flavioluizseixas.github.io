---
import { eventSlug, formatDate, withBase, todayInSaoPaulo } from '../lib/site';
import { localeTag, type Locale } from '../i18n';
const {
  events,
  locale = 'pt',
  title = locale === 'pt' ? 'Calendário completo' : 'Full calendar'
} = Astro.props as { events: any[]; locale?: Locale; title?: string };
const copy = {
  pt: {
    agenda: 'Agenda',
    download: 'Baixar calendário (.ics)',
    filter: 'Filtrar calendário',
    all: 'Todos',
    next: 'Ir para a próxima',
    changed: 'Alterado',
    cancelled: 'Cancelado',
    references: 'Referências:',
    empty: 'O calendário detalhado desta disciplina será publicado em breve.',
    labels: {
      aula: 'Aula',
      laboratorio: 'Laboratório',
      atividade: 'Atividade',
      avaliacao: 'Avaliação',
      entrega: 'Entrega',
      apresentacao: 'Apresentação',
      feriado: 'Feriado',
      'sem-aula': 'Sem aula'
    }
  },
  en: {
    agenda: 'Schedule',
    download: 'Download calendar (.ics)',
    filter: 'Filter calendar',
    all: 'All',
    next: 'Go to next activity',
    changed: 'Changed',
    cancelled: 'Cancelled',
    references: 'References:',
    empty: 'The detailed course calendar will be published soon.',
    labels: {
      aula: 'Lecture',
      laboratorio: 'Lab',
      atividade: 'Activity',
      avaliacao: 'Assessment',
      entrega: 'Due date',
      apresentacao: 'Presentation',
      feriado: 'Public holiday',
      'sem-aula': 'No class'
    }
  }
}[locale];
const today = todayInSaoPaulo();
const types: string[] = [
  ...new Set<string>(events.map((e: any) => String(e.type)))
];
const labels: any = copy.labels;
const next = events.find(
  (e: any) => e.date >= today && !['cancelled', 'completed'].includes(e.status)
);
const moduleLabel = (note?: string) =>
  note?.match(/^(Módulo|Module)\s+\d+\s*[—–-]\s*.+$/i)?.[0] ?? null;
const titleLines = (title: string) =>
  title.split(/;\s+(?=(?:Aula|Lecture)\s+\d+\s*:)/i);
let previousModule: string | null = null;
type AgendaItem = {
  event: any;
  module: string | null;
  startsModule: boolean;
};
const agendaItems: AgendaItem[] = events.map((event: any) => {
  const module = moduleLabel(event.note);
  const startsModule = Boolean(module && module !== previousModule);
  if (module) previousModule = module;
  return { event, module, startsModule };
});
---

<section
  id={locale === 'pt' ? 'calendario' : 'calendar'}
  aria-labelledby="calendar-title"
>
  <div class="section-head">
    <div>
      <span class="eyebrow">{copy.agenda}</span><h2 id="calendar-title">
        {title}
      </h2>
    </div><a
      href={withBase(
        locale === 'pt' ? 'feed/calendario.ics' : 'feed/en/calendar.ics'
      )}>{copy.download}</a
    >
  </div>
  <div class="calendar-controls">
    <div class="chips" aria-label={copy.filter}>
      <button class="chip" data-filter="all" aria-pressed="true"
        >{copy.all}</button
      >{
        types.map((type) => (
          <button class="chip" data-filter={type} aria-pressed="false">
            {labels[type]}
          </button>
        ))
      }
    </div>{
      next && (
        <a
          class="button secondary"
          href={`#${eventSlug(next.date, next.title)}`}
        >
          {copy.next}
        </a>
      )
    }
  </div>
  <ol class="agenda">
    {
      agendaItems.map(({ event, module, startsModule }) => (
        <>
          {startsModule && (
            <li class="agenda-module" data-module-heading={module}>
              <span>{module}</span>
            </li>
          )}
          <li
            class:list={['event', event.status]}
            data-type={event.type}
            data-module={module || undefined}
            id={eventSlug(event.date, event.title)}
          >
            <time class="event-date" datetime={event.date}>
              {formatDate(
                event.date,
                {
                  day: '2-digit',
                  month: 'short',
                  year: undefined
                },
                localeTag(locale)
              )}
              <small>
                {formatDate(
                  event.date,
                  {
                    weekday: 'long',
                    day: undefined,
                    month: undefined,
                    year: undefined
                  },
                  localeTag(locale)
                )}
              </small>
            </time>
            <div>
              <span class:list={['tag', event.type]}>{labels[event.type]}</span>
              {event.status === 'changed' && (
                <span class="tag"> {copy.changed}</span>
              )}
              {event.status === 'cancelled' && (
                <span class="tag"> {copy.cancelled}</span>
              )}
            </div>
            <div>
              <h3 aria-label={event.title}>
                {titleLines(event.title).map((line) => (
                  <span class="event-title-line" aria-hidden="true">
                    {line}
                  </span>
                ))}
              </h3>
              {event.note && !module && <p>{event.note}</p>}
              {event.references?.length > 0 && (
                <p>
                  <strong>{copy.references}</strong>{' '}
                  {event.references.join(' · ')}
                </p>
              )}
              {event.materials?.length > 0 && (
                <p>
                  {event.materials.map((m: any, index: number) => (
                    <>
                      {index > 0 && (
                        <span class="material-separator" aria-hidden="true">
                          {' · '}
                        </span>
                      )}
                      <a href={m.url}>{m.title}</a>
                    </>
                  ))}
                </p>
              )}
            </div>
          </li>
        </>
      ))
    }
  </ol>
  {events.length === 0 && <p class="empty">{copy.empty}</p>}
</section>
<script>
  document.querySelectorAll('[data-filter]').forEach((button) =>
    button.addEventListener('click', () => {
      const filter = (button as HTMLElement).dataset.filter;
      document
        .querySelectorAll('[data-filter]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      document.querySelectorAll('.event').forEach((e) => {
        (e as HTMLElement).hidden =
          filter !== 'all' && (e as HTMLElement).dataset.type !== filter;
      });
      document
        .querySelectorAll<HTMLElement>('.agenda-module')
        .forEach((heading) => {
          const module = heading.dataset.moduleHeading;
          heading.hidden = ![
            ...document.querySelectorAll<HTMLElement>('.event:not([hidden])')
          ].some((event) => event.dataset.module === module);
        });
    })
  );
</script>
